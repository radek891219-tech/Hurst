// Europa vs USA – czy sesja amerykańska odwraca ruch Europy?
//  Dla każdego dnia:
//   • ruch Europy = od startu Europy (domyślnie 09:00 Berlin) do otwarcia USA (09:30 Nowy Jork = zwykle 15:30 CET),
//   • ruch USA    = od otwarcia USA do końca wybranej sesji USA (domyślnie 16:00 Nowy Jork = 22:00 CET).
//  Otwarcie USA liczone w czasie Nowego Jorku, więc przesunięcia zmiany czasu (marzec, październik) są uwzględnione.
//  Tabela: korelacja, ile USA robi na 1% Europy, co USA robi po dużym ruchu Europy w górę / w dół,
//  stabilność w 1. i 2. połowie historii oraz wniosek z istotnością (t). |t| < 2 = zależność nieodróżnialna od przypadku.
//  Interwał wykresu: 30m lub niższy. Więcej historii = pewniejszy wynik (na 30m więcej dni niż na 5m).
//@version=5
indicator("Europa vs USA – sesje", shorttitle="EU vs US", overlay=true)

grpS = "=== Sesje ==="
euSess = input.session("0900-2200", "Start Europy (liczy się początek)", group=grpS, tooltip="Liczy się tylko godzina startu. Europa kończy się w chwili otwarcia USA.")
euTz   = input.string("Europe/Berlin", "Strefa czasowa Europy", group=grpS)
usSess = input.session("0930-1600", "Sesja USA (czas Nowego Jorku)", group=grpS, tooltip="0930-1600 = cała sesja USA. 0930-1130 = pierwsze 2 godziny. 0930-1100 = do zamknięcia Xetry (17:30 CET).")

grpT = "=== Statystyka ==="
bigK = input.float(1.0, "Duży ruch Europy = |ruch| ≥ k × średni |ruch|", minval=0.1, step=0.1, group=grpT)

grpV = "=== Wygląd ==="
showBg  = input.bool(true, "Tło: Europa / USA", group=grpV)
showTbl = input.bool(true, "Tabela", group=grpV)

if timeframe.in_seconds() > 1800
    runtime.error("Użyj interwału 30m lub niższego – otwarcie USA wypada o 15:30 CET.")

// ───────────────────────── Zbieranie dni ─────────────────────────
inEu = not na(time(timeframe.period, euSess, euTz))
inUs = not na(time(timeframe.period, usSess, "America/New_York"))
euBegin = inEu and not inEu[1]
usBegin = inUs and not inUs[1]
usEnd   = not inUs and inUs[1]

var int   st  = 0       // 0 – czekam na Europę, 1 – trwa Europa, 2 – trwa USA
var float euO = na
var float usO = na
var float usC = na
var array<float> aEu = array.new<float>()
var array<float> aUs = array.new<float>()

if st == 2 and usEnd
    array.push(aEu, 100 * (usO / euO - 1))
    array.push(aUs, 100 * (usC / usO - 1))
    st := 0
if euBegin
    st  := 1
    euO := open
if st == 1 and usBegin
    st  := 2
    usO := open
if st == 2 and inUs
    usC := close

bgcolor(showBg and st == 1 and inEu ? color.new(color.blue, 93) : showBg and st == 2 and inUs ? color.new(color.orange, 92) : na, title="Sesje")

// ───────────────────────── Statystyka ─────────────────────────
// mode: 1 – Europa mocno w górę, -1 – mocno w dół, 0 – mały ruch
f_grp(int mode, float thr, int a, int b) =>
    int   n  = 0
    float s  = 0.0
    float s2 = 0.0
    int   rev = 0
    if b > a
        for k = a to b - 1
            float e = array.get(aEu, k)
            float u = array.get(aUs, k)
            bool ok = mode == 1 ? e >= thr : mode == -1 ? e <= -thr : math.abs(e) < thr
            if ok
                n  += 1
                s  += u
                s2 += u * u
                rev += (mode == 1 and u < 0) or (mode == -1 and u > 0) or (mode == 0 and u < 0) ? 1 : 0
    float m  = n > 0 ? s / n : na
    float sd = n > 1 ? math.sqrt(math.max(s2 / n - m * m, 0) * n / (n - 1)) : na
    float t  = n > 1 and sd > 0 ? m / (sd / math.sqrt(n)) : na
    [n, m, n > 0 ? 100.0 * rev / n : na, t]

f_corr(int a, int b) =>
    int n = b - a
    float r = na
    float beta = na
    if n > 2
        float se = 0.0
        float su = 0.0
        for k = a to b - 1
            se += array.get(aEu, k)
            su += array.get(aUs, k)
        float me = se / n
        float mu = su / n
        float cov = 0.0
        float ve  = 0.0
        float vu  = 0.0
        for k = a to b - 1
            float de = array.get(aEu, k) - me
            float du = array.get(aUs, k) - mu
            cov += de * du
            ve  += de * de
            vu  += du * du
        r    := ve > 0 and vu > 0 ? cov / math.sqrt(ve * vu) : na
        beta := ve > 0 ? cov / ve : na
    float t = n > 2 and not na(r) and math.abs(r) < 1 ? r * math.sqrt((n - 2) / (1 - r * r)) : na
    [r, t, beta]

f_fmt(float x, string f) =>
    na(x) ? "–" : str.tostring(x, f)

f_sg(float x, string f) =>
    na(x) ? "–" : (x >= 0 ? "+" : "") + str.tostring(x, f)

f_col(float t) =>
    na(t) or math.abs(t) < 2 ? color.new(color.gray, 40) : t < 0 ? color.new(color.red, 30) : color.new(color.green, 30)

var table tbl = table.new(position.top_right, 5, 11, bgcolor=color.new(color.black, 20), border_width=1)

f_cell(int c, int r, string txt, color bg) =>
    table.cell(tbl, c, r, txt, text_color=color.white, bgcolor=bg, text_size=size.small)

if showTbl and barstate.islast
    int n = array.size(aEu)
    float sumAbs = 0.0
    if n > 0
        for k = 0 to n - 1
            sumAbs += math.abs(array.get(aEu, k))
    float thr = n > 0 ? bigK * sumAbs / n : na
    [r, tr, beta] = f_corr(0, n)
    int h = int(n / 2)
    [r1, tr1, b1] = f_corr(0, h)
    [r2, tr2, b2] = f_corr(h, n)
    [nU, mU, pU, tU] = f_grp(1, thr, 0, n)
    [nD, mD, pD, tD] = f_grp(-1, thr, 0, n)
    [nS, mS, pS, tS] = f_grp(0, thr, 0, n)
    [nU1, mU1, pU1, tU1] = f_grp(1, thr, 0, h)
    [nU2, mU2, pU2, tU2] = f_grp(1, thr, h, n)
    [nD1, mD1, pD1, tD1] = f_grp(-1, thr, 0, h)
    [nD2, mD2, pD2, tD2] = f_grp(-1, thr, h, n)
    color hd = color.new(color.gray, 20)
    color bg = color.new(color.black, 30)

    f_cell(0, 0, "Europa → USA", hd)
    f_cell(1, 0, "Dni", hd)
    f_cell(2, 0, "Śr. ruch USA", hd)
    f_cell(3, 0, "USA w drugą stronę", hd)
    f_cell(4, 0, "t", hd)

    f_cell(0, 1, "Europa mocno w górę (≥ " + f_fmt(thr, "0.00") + " %)", bg)
    f_cell(1, 1, str.tostring(nU), bg)
    f_cell(2, 1, f_sg(mU, "0.00") + " %", f_col(tU))
    f_cell(3, 1, f_fmt(pU, "#") + " %", bg)
    f_cell(4, 1, f_sg(tU, "0.0"), f_col(tU))

    f_cell(0, 2, "Europa mocno w dół (≤ -" + f_fmt(thr, "0.00") + " %)", bg)
    f_cell(1, 2, str.tostring(nD), bg)
    f_cell(2, 2, f_sg(mD, "0.00") + " %", f_col(tD))
    f_cell(3, 2, f_fmt(pD, "#") + " %", bg)
    f_cell(4, 2, f_sg(tD, "0.0"), f_col(tD))

    f_cell(0, 3, "Europa mały ruch (dla porównania)", bg)
    f_cell(1, 3, str.tostring(nS), bg)
    f_cell(2, 3, f_sg(mS, "0.00") + " %", f_col(tS))
    f_cell(3, 3, "spadki " + f_fmt(pS, "#") + " %", bg)
    f_cell(4, 3, f_sg(tS, "0.0"), f_col(tS))

    f_cell(0, 4, "Korelacja Europa / USA", bg)
    f_cell(1, 4, str.tostring(n), bg)
    f_cell(2, 4, "r = " + f_sg(r, "0.00"), f_col(tr))
    f_cell(3, 4, "na 1 % Europy USA: " + f_sg(beta, "0.00") + " %", bg)
    f_cell(4, 4, f_sg(tr, "0.0"), f_col(tr))

    f_cell(0, 5, "Stabilność: 1. połowa / 2. połowa", hd)
    f_cell(1, 5, "Dni", hd)
    f_cell(2, 5, "1. połowa", hd)
    f_cell(3, 5, "2. połowa", hd)
    f_cell(4, 5, "", hd)
    f_cell(0, 6, "Korelacja r", bg)
    f_cell(1, 6, str.tostring(h) + " / " + str.tostring(n - h), bg)
    f_cell(2, 6, f_sg(r1, "0.00") + " (t " + f_sg(tr1, "0.0") + ")", f_col(tr1))
    f_cell(3, 6, f_sg(r2, "0.00") + " (t " + f_sg(tr2, "0.0") + ")", f_col(tr2))
    f_cell(4, 6, "", bg)
    f_cell(0, 7, "Po mocnej Europie w górę: śr. USA", bg)
    f_cell(1, 7, str.tostring(nU1) + " / " + str.tostring(nU2), bg)
    f_cell(2, 7, f_sg(mU1, "0.00") + " %", f_col(tU1))
    f_cell(3, 7, f_sg(mU2, "0.00") + " %", f_col(tU2))
    f_cell(4, 7, "", bg)
    f_cell(0, 8, "Po mocnej Europie w dół: śr. USA", bg)
    f_cell(1, 8, str.tostring(nD1) + " / " + str.tostring(nD2), bg)
    f_cell(2, 8, f_sg(mD1, "0.00") + " %", f_col(tD1))
    f_cell(3, 8, f_sg(mD2, "0.00") + " %", f_col(tD2))
    f_cell(4, 8, "", bg)

    // dziś
    string today = st == 1 ? "Europa teraz: " + f_sg(100 * (close / euO - 1), "0.00") + " % (USA jeszcze nie otwarte)"
                 : st == 2 ? "Europa: " + f_sg(100 * (usO / euO - 1), "0.00") + " %, USA od otwarcia: " + f_sg(100 * (close / usO - 1), "0.00") + " %"
                 : "Poza sesją"
    f_cell(0, 9, "Dziś", hd)
    table.merge_cells(tbl, 1, 9, 4, 9)
    f_cell(1, 9, today, bg)

    // wniosek
    bool revU = not na(tU) and tU <= -2
    bool revD = not na(tD) and tD >= 2
    bool conU = not na(tU) and tU >= 2
    bool conD = not na(tD) and tD <= -2
    bool stable = not na(mU1) and not na(mU2) and not na(mD1) and not na(mD2) and math.sign(mU1) == math.sign(mU2) and math.sign(mD1) == math.sign(mD2)
    string verdict = n < 60 ? "Za mało dni (" + str.tostring(n) + ") – weź niższy interwał z dłuższą historią albo test w Pythonie"
         : revU or revD ? "USA odwraca Europę" + (revU and revD ? " w obie strony" : revU ? " po wzrostach" : " po spadkach") + (stable ? " – w obu połowach" : " – ale NIE w obu połowach, ostrożnie")
         : conU or conD ? "USA kontynuuje ruch Europy" + (stable ? " – w obu połowach" : " – ale NIE w obu połowach, ostrożnie")
         : "Brak istotnej zależności (|t| < 2) – kierunek USA nie wynika z ruchu Europy"
    f_cell(0, 10, "Wniosek", hd)
    table.merge_cells(tbl, 1, 10, 4, 10)
    f_cell(1, 10, verdict, revU or revD or conU or conD ? color.new(color.blue, 30) : bg)
