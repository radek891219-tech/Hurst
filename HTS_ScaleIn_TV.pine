// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// HTS Scale-In – strategia HTS z uśrednianiem wejścia (odpowiednik cBota HTS_ScaleIn_FTMO.cs)
//  • sygnał jak w HTS: trend z pasm 33/144 na H1 → pullback do pasma 33 na H1 → przecięcie pasm na wykresie (m1)
//  • kampania: wejście 1 po rynku + wejścia 2..N jako limity co X% drogi do wspólnego SL
//  • ryzyko kampanii (domyślnie 300 $) dzielone między wejścia – przy pełnym wypełnieniu i SL strata = 300 $
//  • TP1 od średniej ceny: R-krotność wypełnionego ryzyka albo stałe $; na TP1 częściowe zamknięcie,
//    kasowanie niewypełnionych limitów, SL reszty na średnią (BE), trailing w $
//  • ochrona FTMO, okno handlu w UTC, zamykanie w piątek, symulacja wyników na historii
// Wykres = interwał wejść (np. GER40 1m).
//@version=5
indicator("HTS Scale-In [uśrednianie, stałe ryzyko kampanii]", shorttitle="HTS SI", overlay=true, max_bars_back=2000, max_labels_count=500)

// ───────────────────────── Ustawienia ─────────────────────────
grpTF = "=== INTERWAŁY ==="
trendTf = input.timeframe("60", "Trend TF", group=grpTF, tooltip="Interwał wejść = interwał wykresu (w bocie Entry TF = m1).")

grpB = "=== PASMA ==="
tFast = input.int(33, "Trend Fast Period", minval=2, group=grpB)
tSlow = input.int(144, "Trend Slow Period", minval=2, group=grpB)
tType = input.string("Wilder", "Trend MA Type", options=["Wilder", "EMA", "SMA"], group=grpB)
eFast = input.int(33, "Entry Fast Period", minval=2, group=grpB)
eSlow = input.int(144, "Entry Slow Period", minval=2, group=grpB)
eType = input.string("Wilder", "Entry MA Type", options=["Wilder", "EMA", "SMA"], group=grpB)

grpEN = "=== SYGNAŁ ==="
trigMode    = input.string("MACross", "Entry Trigger", options=["MACross", "MA4Cross"], group=grpEN)
minMaSpread = input.float(0.0, "Min MA4Cross Spread (pips)", minval=0, group=grpEN)
minDist     = input.float(1.0, "Min Price Dist from Band (ticks)", minval=0, group=grpEN)

grpR = "=== STOP LOSS ==="
pipSize   = input.float(1.0, "Pip size (jak w cTraderze)", minval=0.00001, group=grpR, tooltip="Sprawdź w cTraderze w informacjach o symbolu. Dla indeksów (GER40) zwykle 1.")
slMode    = input.string("Percent", "SL Calculation Mode", options=["Swing", "BandWidth144", "Percent"], group=grpR)
slPct     = input.float(0.5, "SL % from Entry Price (If Percent)", minval=0.01, step=0.05, group=grpR)
swingBars = input.int(26, "Bars for Swing SL", minval=2, group=grpR)
swingBuf  = input.float(15, "Swing SL Buffer (pips)", minval=0, group=grpR)
bwMult    = input.float(2.0, "SL Multiplier 144", minval=0.1, step=0.1, group=grpR)
minSLp    = input.float(40, "Min SL (pips, entry 1)", minval=0.1, group=grpR)
maxSLp    = input.float(250, "Max SL (pips, entry 1)", minval=0.1, group=grpR)

grpSI = "=== SCALE-IN ==="
campRisk   = input.float(300, "Campaign Risk ($, all entries filled)", minval=1, group=grpSI)
nEntries   = input.int(3, "Number of Entries", minval=1, maxval=5, group=grpSI)
stepPct    = input.float(25, "Step (% of SL distance)", minval=1, maxval=90, group=grpSI)
riskSplit  = input.string("Equal", "Risk Split", options=["Equal", "Increasing", "Decreasing"], group=grpSI)
minLvlSl   = input.float(15, "Min Dist Level→SL (pips)", minval=0.1, group=grpSI)
expiryBars = input.int(60, "Cancel Unfilled Entries After (bars)", minval=1, group=grpSI)
cancelOut  = input.bool(true, "Cancel Unfilled Entries Outside Window", group=grpSI)

grpPM = "=== POSITION MANAGEMENT ==="
tp1Mode  = input.string("RMultiple", "TP1 Mode", options=["RMultiple", "Cash"], group=grpPM)
tp1R     = input.float(1.6, "TP1 (R of filled risk)", minval=0.1, step=0.1, group=grpPM)
tp1Cash  = input.float(480, "TP1 ($, if Cash)", minval=1, group=grpPM)
partPct  = input.float(95, "% Volume to Close at TP1", minval=1, maxval=100, group=grpPM)
trailOn  = input.bool(true, "Trailing Stop Active", group=grpPM)
trStart  = input.float(15, "Trailing Start Profit ($)", minval=1, group=grpPM)
trDist   = input.float(15, "Trailing Distance ($)", minval=1, group=grpPM)
costCash = input.float(0, "Koszt na wejście ($: spread + prowizja)", minval=0, group=grpPM, tooltip="TradingView nie zna spreadu brokera – wpisz średni koszt jednego wejścia.")

grpW = "=== TRADING WINDOW (UTC) ==="
startH = input.int(7, "Start Hour", minval=0, maxval=23, group=grpW)
endH   = input.int(15, "End Hour", minval=0, maxval=23, group=grpW)
blockH = input.int(1, "Block entries N hours before window ends", minval=0, group=grpW)
eodEv  = input.bool(false, "Close EOD Everyday", group=grpW)
eodFri = input.bool(true, "Close EOD on FRIDAY", group=grpW)

grpF = "=== FTMO PROTECTION ==="
ftmoOn     = input.bool(true, "Enable FTMO Protection", group=grpF)
maxDayLoss = input.float(3000, "Max Daily Loss ($, 0 = off)", minval=0, group=grpF)
needRoom   = input.bool(true, "Start Campaign Only If Full Risk Fits Daily Limit", group=grpF)
dayTarget  = input.float(0, "Daily Profit Target ($, 0 = off)", minval=0, group=grpF)
maxCamps   = input.int(3, "Max Campaigns per Day (0 = off)", minval=0, group=grpF)
maxLosses  = input.int(2, "Max Losing Campaigns in a Row (0 = off)", minval=0, group=grpF)
dayTz      = input.string("Europe/Prague", "Strefa czasowa resetu dnia", group=grpF)

grpV = "=== WYGLĄD ==="
showHtf = input.bool(true, "Pasma Trend TF (H1)", group=grpV)
showLtf = input.bool(true, "Pasma Entry TF (wykres)", group=grpV)
showBg  = input.bool(true, "Tło wg trendu", group=grpV)
showLvl = input.bool(true, "Poziomy kampanii", group=grpV)
showTbl = input.bool(true, "Tabela", group=grpV)

// ───────────────────────── Pasma ─────────────────────────
f_ma(float src, simple int n, simple string t) =>
    float r = ta.rma(src, n)
    float e = ta.ema(src, n)
    float s = ta.sma(src, n)
    t == "Wilder" ? r : t == "EMA" ? e : s

eFH = f_ma(high, eFast, eType)
eFL = f_ma(low,  eFast, eType)
eSH = f_ma(high, eSlow, eType)
eSL = f_ma(low,  eSlow, eType)

htFH = f_ma(high, tFast, tType)
htFL = f_ma(low,  tFast, tType)
htSH = f_ma(high, tSlow, tType)
htSL = f_ma(low,  tSlow, tType)
sFH  = math.sum(high, tFast - 1)
sFL  = math.sum(low,  tFast - 1)
sSH  = math.sum(high, tSlow - 1)
sSL  = math.sum(low,  tSlow - 1)
[tFHc, tFLc, tSHc, tSLc, tHc, tLc, tsFH, tsFL, tsSH, tsSL, tOpen] = request.security(syminfo.tickerid, trendTf,
     [htFH[1], htFL[1], htSH[1], htSL[1], high[1], low[1], sFH[1], sFL[1], sSH[1], sSL[1], time], lookahead=barmerge.lookahead_on)

if timeframe.in_seconds(trendTf) < timeframe.in_seconds()
    runtime.error("Trend TF musi być wyższy lub równy interwałowi wykresu.")

// Bieżąca (rozwijająca się) wartość pasm H1 – jak Last(0) w bocie, bez repaintu
htfNew = ta.change(tOpen) != 0
var float runHi = na
var float runLo = na
runHi := htfNew or na(runHi) ? high : math.max(runHi, high)
runLo := htfNew or na(runLo) ? low : math.min(runLo, low)

f_dev(float prevMa, float prevSum, float cur, simple int n, simple string t) =>
    t == "Wilder" ? prevMa + (cur - prevMa) / n : t == "EMA" ? prevMa + (cur - prevMa) * 2.0 / (n + 1) : (prevSum + cur) / n

tFH0 = f_dev(tFHc, tsFH, runHi, tFast, tType)
tFL0 = f_dev(tFLc, tsFL, runLo, tFast, tType)
tSH0 = f_dev(tSHc, tsSH, runHi, tSlow, tType)
tSL0 = f_dev(tSLc, tsSL, runLo, tSlow, tType)

trendNow = tFLc > tSHc ? 1 : tFHc < tSLc ? -1 : 0

// ───────────────────────── Sygnał ─────────────────────────
fMid     = (eFH + eFL) / 2
sMid     = (eSH + eSL) / 2
spreadOk = math.abs(fMid - sMid) / pipSize >= minMaSpread
sigUp = spreadOk and (trigMode == "MACross" ? fMid[1] <= sMid[1] and fMid > sMid : eFL > eSH and eFL[1] <= eSH[1])
sigDn = spreadOk and (trigMode == "MACross" ? fMid[1] >= sMid[1] and fMid < sMid : eFH < eSL and eFH[1] >= eSL[1])

swLo = ta.lowest(low, swingBars)
swHi = ta.highest(high, swingBars)

f_slPrice(int dir, float entry) =>
    float r = na
    if slMode == "Percent"
        r := entry - dir * entry * slPct / 100
    else if slMode == "Swing"
        r := dir == 1 ? swLo - swingBuf * pipSize : swHi + swingBuf * pipSize
    else
        bw = eSH - eSL
        r := bw > 0 ? (dir == 1 ? eSH - bw * bwMult : eSL + bw * bwMult) : na
    math.round_to_mintick(r)

f_inWin(int h) =>
    startH == endH ? true : startH < endH ? (h >= startH and h < endH) : (h >= startH or h < endH)

f_blockOk(int h) =>
    bool ok = true
    if blockH > 0 and startH != endH
        int rem = startH < endH ? endH - h : h >= startH ? (24 - h) + endH : endH - h
        ok := rem > blockH
    ok

// ───────────────────────── Kampania ─────────────────────────
// Wejście k: planowana cena, wielkość w $ na 1 punkt ceny, czy wypełnione, czy limit wciąż czeka, cena wypełnienia
var array<float> lvPx    = array.new_float(5, na)
var array<float> lvUsd   = array.new_float(5, 0.0)
var array<bool>  lvFill  = array.new_bool(5, false)
var array<bool>  lvLive  = array.new_bool(5, false)
var array<float> lvEntry = array.new_float(5, na)

var bool  inCamp    = false
var int   campN     = 0
var int   campDir   = 0
var float campSL    = na
var int   campStart = 0
var bool  tp1Hit    = false
var bool  trailAct  = false
var float maxFav    = na
var float remFrac   = 1.0
var float campReal  = 0.0
var int   campFills = 0

// Suma wielkości, średnia cena i ryzyko wypełnionych wejść
f_agg() =>
    float V  = 0.0
    float s  = 0.0
    float fr = 0.0
    for k = 0 to 4
        if k < campN and array.get(lvFill, k)
            u = array.get(lvUsd, k)
            e = array.get(lvEntry, k)
            V  += u
            s  += u * e
            fr += u * math.abs(e - campSL)
    [V, V > 0 ? s / V : na, fr]

f_cancelPending() =>
    for k = 0 to 4
        array.set(lvLive, k, false)
    true

// Stan bota: 0 WaitTrend, 1 WaitPullback, 2 WaitEntry, 3 InCampaign
var int  trend     = 0
var int  state     = 0
var bool pullback  = false
var bool prevSig   = false
var int  lastPbHtf = na

// FTMO i statystyki
var float  dayRealized = 0.0
var int    campsToday  = 0
var int    consec      = 0
var bool   dayBlocked  = false
var string blockWhy    = ""
var int    nCamps      = 0
var int    nWins       = 0
var float  grossW      = 0.0
var float  grossL      = 0.0
var float  netAll      = 0.0
var float  worstDay    = 0.0
var array<int> fillDist = array.new_int(5, 0)

// Zdarzenia świecy
bool  evPb    = false
bool  evStartL = false
bool  evStartS = false
float pxFill2 = na
float pxFill3 = na
float pxFill4 = na
float pxFill5 = na
float pxTp1   = na
float pxSl    = na
float pxWin   = na
float pxEod   = na
bool  evBlock = false

hOpen  = hour(time, "UTC")
hEntry = hour(time_close, "UTC")
newDay = dayofmonth(time, dayTz) != dayofmonth(time[1], dayTz)

if barstate.isconfirmed
    if newDay
        dayRealized := 0.0
        campsToday  := 0
        consec      := 0
        dayBlocked  := false
        blockWhy    := ""

    // ── trend ──
    if trendNow != trend
        trend    := trendNow
        pullback := false
        prevSig  := false
        if inCamp
            f_cancelPending()
        else
            state := trend == 0 ? 0 : 1

    // ── zarządzanie kampanią ──
    bool  campClosed = false
    float exitPx     = na
    int   why        = 0   // 1 = SL, 2 = BE/trailing, 3 = EOD, 4 = FTMO, 5 = TP1 100%
    if inCamp
        bool outWin   = not f_inWin(hOpen)
        bool isFri    = dayofweek(time, "UTC") == dayofweek.friday
        bool afterEnd = startH < endH ? hOpen >= endH : true

        if outWin and (eodEv or (eodFri and isFri and afterEnd))
            exitPx     := open
            campClosed := true
            why        := 3
        if outWin and cancelOut
            f_cancelPending()
        if bar_index - campStart >= expiryBars
            f_cancelPending()

        // wypełnienie limitów (przed sprawdzeniem SL – cena przechodzi przez poziom zanim dojdzie do SL)
        if not campClosed and not tp1Hit
            for k = 1 to 4
                if k < campN and array.get(lvLive, k)
                    lv = array.get(lvPx, k)
                    if campDir == 1 ? low <= lv : high >= lv
                        fp = campDir == 1 ? math.min(open, lv) : math.max(open, lv)
                        array.set(lvFill, k, true)
                        array.set(lvLive, k, false)
                        array.set(lvEntry, k, fp)
                        campFills += 1
                        if k == 1
                            pxFill2 := fp
                        else if k == 2
                            pxFill3 := fp
                        else if k == 3
                            pxFill4 := fp
                        else
                            pxFill5 := fp

        // wspólny SL
        if not campClosed and (campDir == 1 ? low <= campSL : high >= campSL)
            exitPx     := campDir == 1 ? math.min(open, campSL) : math.max(open, campSL)
            campClosed := true
            why        := tp1Hit ? 2 : 1

        // TP1 od średniej ceny
        bool tpNow = false
        if not campClosed and not tp1Hit
            [V, avg, fr] = f_agg()
            target = tp1Mode == "RMultiple" ? tp1R * fr : tp1Cash
            tp1 = avg + campDir * target / V
            if campDir == 1 ? high >= tp1 : low <= tp1
                if partPct < 100
                    part = V * (tp1 - avg) * campDir * partPct / 100
                    campReal    += part
                    dayRealized += part
                    remFrac := 1 - partPct / 100
                    tp1Hit  := true
                    campSL  := math.round_to_mintick(avg)
                    pxTp1   := tp1
                    tpNow   := true
                    f_cancelPending()
                else
                    exitPx     := tp1
                    campClosed := true
                    why        := 5
                    pxTp1      := tp1

        if not campClosed
            maxFav := campDir == 1 ? math.max(maxFav, high) : math.min(maxFav, low)

        // trailing reszty po TP1 (od następnej świecy)
        if not campClosed and tp1Hit and trailOn and not tpNow
            [V, avg, fr] = f_agg()
            Vr     = V * remFrac
            startD = trStart / Vr
            distD  = trDist / Vr
            prof   = campDir == 1 ? high - avg : avg - low
            if not trailAct and prof >= startD
                trailAct := true
            if trailAct
                newSl  = math.round_to_mintick(maxFav - campDir * distD)
                better = campDir == 1 ? newSl > campSL + pipSize : newSl < campSL - pipSize
                valid  = campDir == 1 ? newSl < close : newSl > close
                if better and valid
                    campSL := newSl

    // ── FTMO: dzienny wynik ──
    float openPnl = 0.0
    if inCamp and not campClosed
        [V, avg, fr] = f_agg()
        openPnl := V * remFrac * (close - avg) * campDir
    dayPnl = dayRealized + openPnl
    if ftmoOn and not dayBlocked and maxDayLoss > 0 and dayPnl <= -maxDayLoss
        dayBlocked := true
        blockWhy   := "limit straty " + str.tostring(dayPnl, "#") + " $"
        evBlock    := true
        if inCamp and not campClosed
            exitPx     := close
            campClosed := true
            why        := 4
    if ftmoOn and not dayBlocked and dayTarget > 0 and dayPnl >= dayTarget
        dayBlocked := true
        blockWhy   := "dzienny cel " + str.tostring(dayPnl, "#") + " $"
        evBlock    := true

    // ── zamknięcie kampanii ──
    if campClosed
        [V, avg, fr] = f_agg()
        rest = V * remFrac * (exitPx - avg) * campDir
        cost = costCash * campFills
        campReal    += rest
        dayRealized += rest - cost
        total = campReal - cost
        nCamps += 1
        netAll += total
        array.set(fillDist, campFills - 1, array.get(fillDist, campFills - 1) + 1)
        if total > 0
            nWins  += 1
            grossW += total
            consec := 0
        else
            grossL -= total
            consec += 1
        if why == 3
            pxEod := exitPx
        else if why == 1 or why == 4
            pxSl := exitPx
        else
            pxWin := exitPx
        if ftmoOn and not dayBlocked and maxLosses > 0 and consec >= maxLosses
            dayBlocked := true
            blockWhy   := str.tostring(consec) + " przegrane kampanie z rzędu"
            evBlock    := true
        f_cancelPending()
        inCamp  := false
        campSL  := na
        state   := trend == 0 ? 0 : pullback ? 2 : 1
        prevSig := trend == 1 ? sigUp[1] : trend == -1 ? sigDn[1] : false
    worstDay := math.min(worstDay, dayRealized + (campClosed ? 0.0 : openPnl))

    // ── pullback na H1 ──
    if state == 1 and trend != 0 and (na(lastPbHtf) or tOpen != lastPbHtf)
        if trend == 1 ? tLc <= tFHc : tHc >= tFLc
            pullback := true
            state    := 2
            evPb     := true
        lastPbHtf := tOpen

    // ── start kampanii ──
    if state == 2 and trend != 0 and not inCamp
        sig = trend == 1 ? sigUp : sigDn
        if not sig
            prevSig := false
        else if not prevSig and f_inWin(hEntry) and f_blockOk(hEntry)
            prevSig := true
            dir = trend
            priceOk = dir == 1 ? close > tFH0 and (close - eFH) / syminfo.mintick >= minDist : close < tFL0 and (eFL - close) / syminfo.mintick >= minDist
            bool ftmoOk = not ftmoOn or (not dayBlocked and (maxCamps == 0 or campsToday < maxCamps) and (not needRoom or maxDayLoss == 0 or dayPnl - campRisk > -maxDayLoss))
            if ftmoOn and not dayBlocked and maxCamps > 0 and campsToday >= maxCamps
                dayBlocked := true
                blockWhy   := str.tostring(campsToday) + " kampanie dziś"
            slPx = f_slPrice(dir, close)
            d    = math.abs(close - slPx)
            slOk = not na(slPx) and d > 0 and d / pipSize >= minSLp and d / pipSize <= maxSLp
            if priceOk and ftmoOk and slOk
                // poziomy wejść
                int n = 0
                for k = 0 to nEntries - 1
                    lvk = k == 0 ? close : math.round_to_mintick(close - dir * d * stepPct * k / 100)
                    if k > 0 and math.abs(lvk - slPx) / pipSize < minLvlSl
                        break
                    array.set(lvPx, k, lvk)
                    n += 1
                // podział ryzyka
                float wSum = 0.0
                for k = 0 to n - 1
                    wSum += riskSplit == "Equal" ? 1.0 : riskSplit == "Increasing" ? k + 1.0 : n - k * 1.0
                for k = 0 to 4
                    if k < n
                        w = riskSplit == "Equal" ? 1.0 : riskSplit == "Increasing" ? k + 1.0 : n - k * 1.0
                        lvk = array.get(lvPx, k)
                        array.set(lvUsd, k, campRisk * w / wSum / math.abs(lvk - slPx))
                        array.set(lvFill, k, k == 0)
                        array.set(lvLive, k, k > 0)
                        array.set(lvEntry, k, k == 0 ? lvk : na)
                    else
                        array.set(lvFill, k, false)
                        array.set(lvLive, k, false)
                inCamp    := true
                campN     := n
                campDir   := dir
                campSL    := slPx
                campStart := bar_index
                tp1Hit    := false
                trailAct  := false
                maxFav    := close
                remFrac   := 1.0
                campReal  := 0.0
                campFills := 1
                state     := 3
                campsToday += 1
                evStartL  := dir == 1
                evStartS  := dir == -1

// ───────────────────────── Poziomy do rysowania ─────────────────────────
f_pend(int k) =>
    inCamp and k < campN and array.get(lvLive, k) ? array.get(lvPx, k) : na

float lvAvg = na
float lvTp1 = na
if inCamp
    [V, avg, fr] = f_agg()
    lvAvg := avg
    target = tp1Mode == "RMultiple" ? tp1R * fr : tp1Cash
    lvTp1 := tp1Hit ? na : avg + campDir * target / V

// ───────────────────────── Wykres ─────────────────────────
pTFH = plot(showHtf ? tFH0 : na, "Trend Fast High", color=color.new(color.blue, 0), linewidth=2)
pTFL = plot(showHtf ? tFL0 : na, "Trend Fast Low",  color=color.new(color.blue, 0), linewidth=2)
pTSH = plot(showHtf ? tSH0 : na, "Trend Slow High", color=color.new(color.orange, 0), linewidth=2)
pTSL = plot(showHtf ? tSL0 : na, "Trend Slow Low",  color=color.new(color.orange, 0), linewidth=2)
fill(pTFH, pTFL, color=color.new(color.blue, 85), title="Trend Fast pasmo")
fill(pTSH, pTSL, color=color.new(color.orange, 85), title="Trend Slow pasmo")

pEFH = plot(showLtf ? eFH : na, "Entry Fast High", color=color.new(color.aqua, 30))
pEFL = plot(showLtf ? eFL : na, "Entry Fast Low",  color=color.new(color.aqua, 30))
pESH = plot(showLtf ? eSH : na, "Entry Slow High", color=color.new(color.fuchsia, 30))
pESL = plot(showLtf ? eSL : na, "Entry Slow Low",  color=color.new(color.fuchsia, 30))
fill(pEFH, pEFL, color=color.new(color.aqua, 90), title="Entry Fast pasmo")
fill(pESH, pESL, color=color.new(color.fuchsia, 90), title="Entry Slow pasmo")

plot(showLvl and inCamp ? array.get(lvPx, 0) : na, "Wejście 1", color=color.new(color.gray, 0), style=plot.style_linebr)
plot(showLvl ? f_pend(1) : na, "Limit 2", color=color.new(color.yellow, 20), style=plot.style_circles)
plot(showLvl ? f_pend(2) : na, "Limit 3", color=color.new(color.yellow, 20), style=plot.style_circles)
plot(showLvl ? f_pend(3) : na, "Limit 4", color=color.new(color.yellow, 20), style=plot.style_circles)
plot(showLvl ? f_pend(4) : na, "Limit 5", color=color.new(color.yellow, 20), style=plot.style_circles)
plot(showLvl ? lvAvg : na, "Średnia cena", color=color.new(color.white, 0), style=plot.style_linebr, linewidth=2)
plot(showLvl and inCamp ? campSL : na, "SL kampanii", color=color.new(color.red, 0), style=plot.style_linebr, linewidth=2)
plot(showLvl ? lvTp1 : na, "TP1", color=color.new(color.lime, 0), style=plot.style_linebr, linewidth=2)

bgcolor(showBg and trend == 1 ? color.new(color.green, 94) : showBg and trend == -1 ? color.new(color.red, 94) : na, title="Trend H1")
bgcolor(dayBlocked ? color.new(color.orange, 90) : na, title="Blokada FTMO")

plotshape(evPb, "Pullback H1", shape.diamond, location.top, color.new(color.yellow, 0), text="PB", textcolor=color.yellow, size=size.tiny)
plotshape(evStartL, "Start kampanii long",  shape.labelup,   location.belowbar, color.new(color.lime, 0), text="1", textcolor=color.black, size=size.small)
plotshape(evStartS, "Start kampanii short", shape.labeldown, location.abovebar, color.new(color.red, 0),  text="1", textcolor=color.white, size=size.small)
plotshape(pxFill2, "Dokładka 2", shape.circle, location.absolute, color.new(color.yellow, 0), text="2", textcolor=color.yellow, size=size.tiny)
plotshape(pxFill3, "Dokładka 3", shape.circle, location.absolute, color.new(color.yellow, 0), text="3", textcolor=color.yellow, size=size.tiny)
plotshape(pxFill4, "Dokładka 4", shape.circle, location.absolute, color.new(color.yellow, 0), text="4", textcolor=color.yellow, size=size.tiny)
plotshape(pxFill5, "Dokładka 5", shape.circle, location.absolute, color.new(color.yellow, 0), text="5", textcolor=color.yellow, size=size.tiny)
plotshape(pxTp1, "TP1",          shape.diamond, location.absolute, color.new(color.lime, 0),  size=size.small)
plotshape(pxWin, "Wyjście z zyskiem / BE", shape.flag, location.absolute, color.new(color.green, 0), size=size.tiny)
plotshape(pxSl,  "SL kampanii",  shape.xcross, location.absolute, color.new(color.red, 0),   size=size.small)
plotshape(pxEod, "Zamknięcie EOD", shape.square, location.absolute, color.new(color.gray, 0), size=size.tiny)
plotshape(evBlock, "Blokada FTMO", shape.labeldown, location.top, color.new(color.orange, 0), text="FTMO STOP", textcolor=color.black, size=size.small)

// ───────────────────────── Tabela ─────────────────────────
var table tbl = table.new(position.top_right, 2, 15, bgcolor=color.new(color.black, 15), border_width=1)
if showTbl and barstate.islast
    stTxt = state == 0 ? "Czekam na trend" : state == 1 ? "Czekam na pullback H1" : state == 2 ? "Czekam na przecięcie pasm" : "KAMPANIA AKTYWNA"
    trTxt = trend == 1 ? "W GÓRĘ" : trend == -1 ? "W DÓŁ" : "BRAK"
    trCol = trend == 1 ? color.green : trend == -1 ? color.red : color.gray
    string campTxt = "–"
    float  op = 0.0
    if inCamp
        [V, avg, fr] = f_agg()
        op := V * remFrac * (close - avg) * campDir
        int waiting = 0
        for k = 1 to 4
            if k < campN and array.get(lvLive, k)
                waiting += 1
        campTxt := str.tostring(campFills) + " wypełn. / " + str.tostring(waiting) + " czeka | ryzyko " + str.tostring(fr, "#") + " $" + (tp1Hit ? " | po TP1" : "")
    dp      = dayRealized + op
    winRate = nCamps > 0 ? 100.0 * nWins / nCamps : na
    pf      = grossL > 0 ? grossW / grossL : na
    distTxt = ""
    for k = 0 to nEntries - 1
        distTxt += (k > 0 ? " | " : "") + str.tostring(k + 1) + ": " + str.tostring(array.get(fillDist, k))
    table.cell(tbl, 0, 0, "Trend " + trendTf, text_color=color.white)
    table.cell(tbl, 1, 0, trTxt, text_color=color.white, bgcolor=trCol)
    table.cell(tbl, 0, 1, "Stan", text_color=color.white)
    table.cell(tbl, 1, 1, stTxt, text_color=color.white, bgcolor=state == 3 ? color.blue : color.gray)
    table.cell(tbl, 0, 2, "Ryzyko kampanii", text_color=color.white)
    table.cell(tbl, 1, 2, str.tostring(campRisk, "#") + " $ | " + str.tostring(nEntries) + " wejścia co " + str.tostring(stepPct, "#") + "% SL", text_color=color.white)
    table.cell(tbl, 0, 3, "Kampania", text_color=color.white)
    table.cell(tbl, 1, 3, campTxt, text_color=color.white)
    table.cell(tbl, 0, 4, "Średnia / SL / TP1", text_color=color.white)
    table.cell(tbl, 1, 4, inCamp ? str.tostring(lvAvg, format.mintick) + " / " + str.tostring(campSL, format.mintick) + " / " + (na(lvTp1) ? "po TP1" : str.tostring(lvTp1, format.mintick)) : "–", text_color=color.white)
    table.cell(tbl, 0, 5, "Otwarty wynik ($)", text_color=color.white)
    table.cell(tbl, 1, 5, str.tostring(op, "#.00"), text_color=color.white, bgcolor=op >= 0 ? color.new(color.green, 40) : color.new(color.red, 40))
    table.cell(tbl, 0, 6, "Dziś ($)", text_color=color.white)
    table.cell(tbl, 1, 6, str.tostring(dp, "#.00") + (maxDayLoss > 0 ? "  (limit -" + str.tostring(maxDayLoss, "#") + ")" : ""), text_color=color.white, bgcolor=dp >= 0 ? color.new(color.green, 40) : color.new(color.red, 40))
    table.cell(tbl, 0, 7, "Kampanie dziś / straty z rzędu", text_color=color.white)
    table.cell(tbl, 1, 7, str.tostring(campsToday) + (maxCamps > 0 ? "/" + str.tostring(maxCamps) : "") + " / " + str.tostring(consec), text_color=color.white)
    table.cell(tbl, 0, 8, "FTMO", text_color=color.white)
    table.cell(tbl, 1, 8, not ftmoOn ? "WYŁ." : dayBlocked ? "STOP: " + blockWhy : "OK", text_color=color.white, bgcolor=dayBlocked ? color.orange : color.green)
    table.cell(tbl, 0, 9, "Kampanie (historia)", text_color=color.white)
    table.cell(tbl, 1, 9, str.tostring(nCamps), text_color=color.white)
    table.cell(tbl, 0, 10, "Skuteczność", text_color=color.white)
    table.cell(tbl, 1, 10, str.tostring(winRate, "#.0") + " %", text_color=color.white)
    table.cell(tbl, 0, 11, "Profit factor", text_color=color.white)
    table.cell(tbl, 1, 11, str.tostring(pf, "#.00"), text_color=color.white)
    table.cell(tbl, 0, 12, "Wynik netto ($)", text_color=color.white)
    table.cell(tbl, 1, 12, str.tostring(netAll, "#.00"), text_color=color.white, bgcolor=netAll >= 0 ? color.green : color.red)
    table.cell(tbl, 0, 13, "Najgorszy dzień ($)", text_color=color.white)
    table.cell(tbl, 1, 13, str.tostring(worstDay, "#.00"), text_color=color.white, bgcolor=maxDayLoss > 0 and worstDay <= -maxDayLoss ? color.red : color.gray)
    table.cell(tbl, 0, 14, "Ile wejść się wypełniło", text_color=color.white)
    table.cell(tbl, 1, 14, distTxt, text_color=color.white)

// ───────────────────────── Alerty ─────────────────────────
alertcondition(evStartL, "HTS SI start LONG", "HTS Scale-In: start kampanii LONG {{ticker}} @ {{close}}")
alertcondition(evStartS, "HTS SI start SHORT", "HTS Scale-In: start kampanii SHORT {{ticker}} @ {{close}}")
alertcondition(not na(pxFill2) or not na(pxFill3) or not na(pxFill4) or not na(pxFill5), "HTS SI dokładka", "HTS Scale-In: dokładka wypełniona {{ticker}} @ {{close}}")
alertcondition(not na(pxTp1), "HTS SI TP1", "HTS Scale-In: TP1 {{ticker}} @ {{close}}")
alertcondition(not na(pxSl) or not na(pxWin) or not na(pxEod), "HTS SI koniec kampanii", "HTS Scale-In: kampania zamknięta {{ticker}} @ {{close}}")

if evStartL or evStartS
    msg = "HTS SI " + (evStartL ? "LONG " : "SHORT ") + syminfo.ticker + " | wejście 1 @ " + str.tostring(array.get(lvPx, 0), format.mintick)
    for k = 1 to 4
        if k < campN
            msg += " | limit " + str.tostring(k + 1) + " @ " + str.tostring(array.get(lvPx, k), format.mintick)
    msg += " | SL " + str.tostring(campSL, format.mintick)
    alert(msg, alert.freq_once_per_bar_close)
