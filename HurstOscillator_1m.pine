// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// Hurst Oscillator [LazyBear] – wersja pod 1m (Nasdaq: NQ / MNQ / NAS100), osobny panel
//  • oryginalna logika LazyBear: oscylator = cena − wycentrowana MA (przesunięta o length/2+1)
//  • jednostka w ATR (domyślnie) albo w % jak w oryginale → poziomy ±1.6 / ±2.6 / ±4.2
//  • wykładnik Hursta (R/S) jako filtr reżimu, filtr trendu z 15m, filtr sesji NY
//  • sygnały na zamkniętych świecach, cooldown, alerty, tabela
//@version=5
indicator("Hurst Oscillator 1m [LazyBear mod]", shorttitle="HurstOsc 1m", overlay=false, max_bars_back=500)

// ───────────────────────── Ustawienia ─────────────────────────
grpO = "Oscylator Hursta (LazyBear)"
src       = input.source(hl2, "Źródło", group=grpO)
length    = input.int(10, "Długość CMA", minval=2, group=grpO)
oscMode   = input.string("ATR", "Jednostka", options=["ATR", "Procent (oryginał LB)"], group=grpO)
atrLen    = input.int(100, "Długość ATR", minval=1, group=grpO)
innerVal  = input.float(1.6, "Poziom wewnętrzny", step=0.1, group=grpO)
outerVal  = input.float(2.6, "Poziom zewnętrzny", step=0.1, group=grpO)
extremeV  = input.float(4.2, "Poziom ekstremalny", step=0.1, group=grpO)
sigLen    = input.int(5, "Linia sygnału (EMA)", minval=1, group=grpO)

grpH = "Wykładnik Hursta (reżim rynku)"
hWin      = input.int(128, "Okno R/S (świece)", options=[64, 128, 256], group=grpH, tooltip="Na 1m: 128 ≈ 2 godziny.")
hSmooth   = input.int(5, "Wygładzanie H (EMA)", minval=1, group=grpH)
hMR       = input.float(0.47, "H poniżej = powrót do średniej", step=0.01, group=grpH)
hTR       = input.float(0.53, "H powyżej = trend", step=0.01, group=grpH)
useRegime = input.bool(true, "Filtruj sygnały reżimem H", group=grpH)
showBg    = input.bool(true, "Koloruj tło wg reżimu", group=grpH)

grpF = "Filtry i sygnały"
useHtf    = input.bool(true, "Filtr trendu z wyższego TF", group=grpF)
htfTf     = input.timeframe("15", "Wyższy interwał", group=grpF)
htfLen    = input.int(50, "EMA na wyższym TF", minval=1, group=grpF)
showMR    = input.bool(true, "Sygnały powrotu z pasma (MR)", group=grpF)
showBO    = input.bool(true, "Sygnały wybicia (BO)", group=grpF)
cooldown  = input.int(5, "Min. odstęp między sygnałami (świece)", minval=0, group=grpF)
useSess   = input.bool(true, "Sygnały tylko w sesji", group=grpF)
sessStr   = input.session("0935-1555", "Sesja (czas Nowego Jorku)", group=grpF)
showTbl   = input.bool(true, "Pokaż tabelę", group=grpF)

// ───────────────────────── Oscylator (LazyBear) ─────────────────────────
disp = math.floor(length / 2) + 1
cma  = ta.sma(src[disp], length)
osc  = oscMode == "ATR" ? (src - cma) / ta.atr(atrLen) : (src - cma) / cma * 100
sig  = ta.ema(osc, sigLen)

// ───────────────────────── Wykładnik Hursta (R/S) ─────────────────────────
ret = math.log(close / close[1])

f_rs(int n) =>
    float acc = 0.0
    for i = 0 to n - 1
        acc += ret[i]
    float mean = acc / n
    float cum = 0.0
    float mx  = 0.0
    float mn  = 0.0
    float ss  = 0.0
    for i = n - 1 to 0
        float d = ret[i] - mean
        cum += d
        mx := math.max(mx, cum)
        mn := math.min(mn, cum)
        ss += d * d
    float sd = math.sqrt(ss / n)
    sd > 0 ? (mx - mn) / sd : na

f_ers(int n) =>
    float s = 0.0
    for i = 1 to n - 1
        s += math.sqrt(float(n - i) / i)
    ((n - 0.5) / n) * s / (math.sqrt(math.pi) * math.sqrt(n / 2.0 - 0.25))

n1 = int(hWin / 8)
n2 = int(hWin / 4)
n3 = int(hWin / 2)
n4 = hWin
var float e1 = f_ers(n1)
var float e2 = f_ers(n2)
var float e3 = f_ers(n3)
var float e4 = f_ers(n4)

y1 = math.log(f_rs(n1) / e1)
y2 = math.log(f_rs(n2) / e2)
y3 = math.log(f_rs(n3) / e3)
y4 = math.log(f_rs(n4) / e4)
x1 = math.log(n1)
x2 = math.log(n2)
x3 = math.log(n3)
x4 = math.log(n4)
xm = (x1 + x2 + x3 + x4) / 4
ym = (y1 + y2 + y3 + y4) / 4
slope = ((x1 - xm) * (y1 - ym) + (x2 - xm) * (y2 - ym) + (x3 - xm) * (y3 - ym) + (x4 - xm) * (y4 - ym)) /
     (math.pow(x1 - xm, 2) + math.pow(x2 - xm, 2) + math.pow(x3 - xm, 2) + math.pow(x4 - xm, 2))
// Kalibracja empiryczna (symulacja Monte Carlo): dla błądzenia losowego H ≈ 0.50
hBias    = hWin == 64 ? 0.064 : hWin == 128 ? 0.030 : 0.010
hurstRaw = bar_index > hWin ? 0.5 + slope + hBias : na
hurst    = ta.ema(hurstRaw, hSmooth)

isMR    = hurst < hMR
isTrend = hurst > hTR

// ───────────────────────── Filtry ─────────────────────────
htfEma = request.security(syminfo.tickerid, htfTf, ta.ema(close, htfLen)[1], lookahead=barmerge.lookahead_on)
htfUp  = close > htfEma
htfDn  = close < htfEma
inSess = not useSess or not na(time(timeframe.period, sessStr, "America/New_York"))
okBar  = barstate.isconfirmed and inSess

// ───────────────────────── Sygnały ─────────────────────────
// MR: oscylator wraca z obszaru za pasmem zewnętrznym
mrLongF  = showMR and ta.crossover(osc, -outerVal) and (not useRegime or not isTrend) and (not useHtf or not htfDn)
mrShortF = showMR and ta.crossunder(osc, outerVal) and (not useRegime or not isTrend) and (not useHtf or not htfUp)
// BO: oscylator przebija pasmo zewnętrzne w reżimie trendu
boLongF  = showBO and ta.crossover(osc, outerVal)   and (not useRegime or isTrend) and (not useHtf or htfUp)
boShortF = showBO and ta.crossunder(osc, -outerVal) and (not useRegime or isTrend) and (not useHtf or htfDn)

var int lastLong  = -100000
var int lastShort = -100000
longOk  = bar_index - lastLong  > cooldown
shortOk = bar_index - lastShort > cooldown

mrLong  = okBar and longOk  and mrLongF
boLong  = okBar and longOk  and boLongF and not mrLong
mrShort = okBar and shortOk and mrShortF
boShort = okBar and shortOk and boShortF and not mrShort

if mrLong or boLong
    lastLong := bar_index
if mrShort or boShort
    lastShort := bar_index

// ───────────────────────── Wykres ─────────────────────────
col = osc >= 0 ? (osc > osc[1] ? color.new(color.green, 0) : color.new(color.green, 50)) : (osc < osc[1] ? color.new(color.red, 0) : color.new(color.red, 50))
plot(osc, "Oscylator", style=plot.style_columns, color=col)
plot(sig, "Sygnał", color=color.orange)

hline(0, "Zero", color=color.gray)
hU1 = hline(innerVal,  "Wewn. +", color=color.new(color.teal, 50), linestyle=hline.style_dotted)
hL1 = hline(-innerVal, "Wewn. -", color=color.new(color.teal, 50), linestyle=hline.style_dotted)
hU2 = hline(outerVal,  "Zewn. +", color=color.new(color.red, 30))
hL2 = hline(-outerVal, "Zewn. -", color=color.new(color.green, 30))
hU3 = hline(extremeV,  "Ekstr. +", color=color.new(color.red, 60), linestyle=hline.style_dashed)
hL3 = hline(-extremeV, "Ekstr. -", color=color.new(color.green, 60), linestyle=hline.style_dashed)
fill(hU1, hL1, color=color.new(color.teal, 95))
fill(hU2, hU3, color=color.new(color.red, 90))
fill(hL2, hL3, color=color.new(color.green, 90))

bgcolor(showBg and isTrend ? color.new(color.blue, 90) : showBg and isMR ? color.new(color.purple, 90) : na, title="Tło reżimu")

plotshape(mrLong,  "MR Long",  shape.triangleup,   location.bottom, color.new(color.green, 0),  text="MR", textcolor=color.green, size=size.tiny)
plotshape(mrShort, "MR Short", shape.triangledown, location.top,    color.new(color.red, 0),    text="MR", textcolor=color.red,   size=size.tiny)
plotshape(boLong,  "BO Long",  shape.labelup,      location.bottom, color.new(color.lime, 0),   text="BO", textcolor=color.black, size=size.tiny)
plotshape(boShort, "BO Short", shape.labeldown,    location.top,    color.new(color.maroon, 0), text="BO", textcolor=color.white, size=size.tiny)

// ───────────────────────── Tabela ─────────────────────────
var table tbl = table.new(position.top_right, 2, 3, bgcolor=color.new(color.black, 20), border_width=1)
if showTbl and barstate.islast
    regTxt = isTrend ? "TREND" : isMR ? "POWRÓT DO ŚREDNIEJ" : "NEUTRALNY"
    regCol = isTrend ? color.blue : isMR ? color.purple : color.gray
    table.cell(tbl, 0, 0, "Hurst H", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 0, str.tostring(hurst, "#.000"), text_color=color.white, text_size=size.small)
    table.cell(tbl, 0, 1, "Reżim", text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 1, regTxt, text_color=color.white, bgcolor=regCol, text_size=size.small)
    table.cell(tbl, 0, 2, "Trend " + htfTf, text_color=color.white, text_size=size.small)
    table.cell(tbl, 1, 2, htfUp ? "W GÓRĘ" : "W DÓŁ", text_color=color.white, bgcolor=htfUp ? color.green : color.red, text_size=size.small)

// ───────────────────────── Alerty ─────────────────────────
alertcondition(mrLong,  "MR Long",  "HurstOsc 1m: powrót z dolnego pasma (LONG) {{ticker}} @ {{close}}")
alertcondition(mrShort, "MR Short", "HurstOsc 1m: powrót z górnego pasma (SHORT) {{ticker}} @ {{close}}")
alertcondition(boLong,  "BO Long",  "HurstOsc 1m: wybicie w górę w trendzie (LONG) {{ticker}} @ {{close}}")
alertcondition(boShort, "BO Short", "HurstOsc 1m: wybicie w dół w trendzie (SHORT) {{ticker}} @ {{close}}")
alertcondition(mrLong or boLong or mrShort or boShort, "Dowolny sygnał", "HurstOsc 1m: sygnał {{ticker}} @ {{close}}")
